# EARTHDATA LOGIN VARIABLES
# Copy this to .env; add values. Tokens are generated at: https://urs.earthdata.nasa.gov/
# and will last 60 days.
EARTHDATA_TOKEN=
EARTHDATA_TOKEN_DATE=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# COPERNICUS DATA SPACE ECOSYSTEM (CDSE) LOGIN VARIABLES
# Needed to download Sentinel-1 WV vignettes (searching needs no login).
# Register for free at: https://dataspace.copernicus.eu/
CDSE_USERNAME=
CDSE_PASSWORD=